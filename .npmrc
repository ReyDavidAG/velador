# Política de instalación (la misma del proyecto de referencia).

# Ninguna dependencia corre scripts de instalación: es la vía de los ataques de cadena de suministro.
# También apaga los pre/post scripts de este package.json; `npm run build` corre normal.
ignore-scripts=true

# Sólo paquetes del registro, nada de URLs de git ni tarballs sueltos.
allow-git=none

# En días: no se instala una versión publicada hace menos de una semana.
min-release-age=7

# Versiones exactas, sin `^`.
save-exact=true
